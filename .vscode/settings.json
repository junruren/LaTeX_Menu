{
  // LaTeX Workshop: saving any menu .tex runs tools/build.sh, which puts
  // shared/ on TeX's search path and writes <event>/build/menu.pdf and
  // <event>/build/menu-print.pdf. The preview opens in a VS Code tab.
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.build.forceRecipeUsage": true,
  "latex-workshop.latex.recipe.default": "first",
  "latex-workshop.latex.recipes": [
    { "name": "Menu: screen + print PDFs", "tools": ["menu"] },
    { "name": "Menu: screen PDF only",     "tools": ["menu-screen"] }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "menu",
      "command": "sh",
      "args": ["%WORKSPACE_FOLDER%/tools/build.sh", "%DOC%.tex"]
    },
    {
      "name": "menu-screen",
      "command": "sh",
      "args": ["%WORKSPACE_FOLDER%/tools/build.sh", "--no-print", "%DOC%.tex"]
    }
  ],
  "latex-workshop.latex.autoClean.run": "never",
  "latex-workshop.view.pdf.viewer": "tab",
  "files.associations": { "*.cls": "latex", "*.sty": "latex" }
}
