% =====================================================================
%  cocktailglasses.sty  --  line-art glassware icons drawn with TikZ
% ---------------------------------------------------------------------
%  Usage:   \glassicon{coupe}          % default height 0.55in
%           \glassicon[1in]{snifter}   % custom height
%
%  Every glass is drawn inside the same box (x: -0.6..0.6, y: 0..1.75),
%  so icons line up on a common baseline at any size.
%
%  Add your own glass in the preamble:
%     \DeclareGlass{mycup}{ \glassbowl{(-0.3,1) -- (-0.3,0) -- (0.3,0)
%                                      -- (0.3,1) -- cycle}{0.8} }
%     \GlassAlias{teacup}{mycup}
%
%  Helpers available inside \DeclareGlass:
%     \glassbowl[<liquid bottom y>]{<closed path>}{<liquid top y>}
%     \glassstem{<top y>}          % stem from the foot up to <top y>
%     \glassfoot{<half width>}     % foot resting on y = 0
%  TikZ styles: glass, glass detail, liquid, glass solid
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cocktailglasses}[2026/11/21 v1.0 Line-art glassware icons]

\RequirePackage{tikz}
\RequirePackage{xcolor}

% Colours (the cocktailmenu class re-points these at the menu palette)
\colorlet{glassline}{black!85}
\colorlet{glassliquid}{black!12}

\tikzset{
  glass/.style        = {draw=glassline, line width=0.5pt,
                         line cap=round, line join=round},
  glass detail/.style = {glass, line width=0.35pt},
  liquid/.style       = {fill=glassliquid},
  glass solid/.style  = {fill=glassliquid},  % opaque vessels: copper, metal, ceramic
}

% ---------------------------------------------------------------------
%  Registry
% ---------------------------------------------------------------------
\ExplSyntaxOn
\seq_new:N \g_cocktailglasses_names_seq
\prop_new:N \g_cocktailglasses_alias_prop
\dim_new:N \l__cocktailglasses_unit_dim

\msg_new:nnn { cocktailglasses } { unknown-glass }
  { Unknown~glass~style~`#1'.~Known~styles:~#2. }

\NewDocumentCommand \DeclareGlass { m +m }
  {
    \cs_gset_protected:cpn { cocktailglass@#1 } {#2}
    \seq_if_in:NnF \g_cocktailglasses_names_seq {#1}
      { \seq_gput_right:Nn \g_cocktailglasses_names_seq {#1} }
  }

\NewDocumentCommand \GlassAlias { m m }
  {
    \cs_gset_eq:cc { cocktailglass@#1 } { cocktailglass@#2 }
    \prop_gput:Nnn \g_cocktailglasses_alias_prop {#1} {#2}
  }

% \glassicon[<height>]{<style>}
\NewDocumentCommand \glassicon { O{0.55in} m }
  {
    \tl_if_blank:eF {#2}
      {
        \cs_if_exist:cTF { cocktailglass@#2 }
          {
            \dim_set:Nn \l__cocktailglasses_unit_dim { (#1) * 100 / 175 }
            \begin{tikzpicture}
              [ x = \l__cocktailglasses_unit_dim,
                y = \l__cocktailglasses_unit_dim,
                baseline = 0pt ]
              \useasboundingbox (-0.6,0) rectangle (0.6,1.75);
              \use:c { cocktailglass@#2 }
            \end{tikzpicture}
          }
          {
            \msg_warning:nnee { cocktailglasses } { unknown-glass } {#2}
              { \seq_use:Nn \g_cocktailglasses_names_seq { ,~ } }
            \fbox{\tiny ?~#2}
          }
      }
  }

% \glasscatalog : a reference grid of every glass (used by glass-catalog.tex)
\NewDocumentCommand \glasscatalog { O{0.75in} }
  {
    \par\noindent
    \seq_map_inline:Nn \g_cocktailglasses_names_seq
      {
        \begin{minipage}[t][\dimexpr#1+0.46in\relax]{0.245\linewidth}
          \vspace{0pt}
          \centering
          \glassicon[#1]{##1}\par\smallskip
          {\small\ttfamily ##1}\par
          {\scriptsize\ttfamily\color{black!55}
            \prop_map_inline:Nn \g_cocktailglasses_alias_prop
              { \tl_if_eq:nnT {####2} {##1} { ####1 \par } }
            \mbox{}}
        \end{minipage}
        \hfill\allowbreak
      }
    \par
  }
\ExplSyntaxOff

% ---------------------------------------------------------------------
%  Drawing helpers
% ---------------------------------------------------------------------
% \glassbowl[<liquid bottom>]{<closed path>}{<liquid level>}
\NewDocumentCommand\glassbowl{O{-1} m m}{%
  \begin{scope}
    \clip #2;
    \fill[liquid] (-1,#1) rectangle (1,#3);
  \end{scope}
  \draw[glass] #2;%
}
\NewDocumentCommand\glassstem{m}{\draw[glass] (0,0.1) -- (0,#1);}
\NewDocumentCommand\glassfoot{m}{%
  \draw[glass] (-#1,0) .. controls (-0.45*#1,0.01) and (-0.03,0.05) .. (0,0.1)
                       .. controls (0.03,0.05) and (0.45*#1,0.01) .. (#1,0) -- cycle;}
% a small leaf, e.g. mint: \glassleaf{<x>}{<y>}{<angle>}
\NewDocumentCommand\glassleaf{m m m}{%
  \filldraw[glass detail, fill=glassliquid, rotate around={#3:(#1,#2)}]
    (#1,#2) .. controls (#1-0.09,#2+0.06) and (#1-0.07,#2+0.17) .. (#1,#2+0.22)
            .. controls (#1+0.07,#2+0.17) and (#1+0.09,#2+0.06) .. (#1,#2) -- cycle;}

